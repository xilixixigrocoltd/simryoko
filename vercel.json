{
  "version": 2,
  "builds": [
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ],
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, s-maxage=0, must-revalidate, no-store"}
      ]
    },
    {
      "source": "/js/sw.js",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, s-maxage=0, must-revalidate, no-store"}
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, s-maxage=0, must-revalidate"}
      ]
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
